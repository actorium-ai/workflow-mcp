{
  "name": "@actorium-ai/actorium-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing feature/task/document/identity context from the workflow BFF API",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batu4404/workflow-mcp.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "bin": {
    "actorium-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --ignore-pattern '**/*.test.ts'",
    "lint:fix": "eslint src --ext .ts --ignore-pattern '**/*.test.ts' --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
